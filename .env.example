# 接收端环境变量(部署时复制为 .env 并填入真实值)
# 不要把 .env 提交到仓库
DHCP_UPLOAD_TOKEN=<YOUR_UPLOAD_TOKEN>
DHCP_DATA_DIR=/data/dhcp/data
DHCP_RETENTION_DAYS=7
DHCP_BIND_HOST=0.0.0.0
DHCP_BIND_PORT=8000
LOG_LEVEL=INFO

# CMDB(cmdb_client.py 中也写了一份,优先使用代码里的)
CMDB_BASE_URL=http://<CMDB_HOST>:8000
CMDB_API_KEY=<YOUR_CMDB_API_KEY>
CMDB_API_SECRET=<YOUR_CMDB_API_SECRET>
